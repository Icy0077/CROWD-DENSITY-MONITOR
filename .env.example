FACILITY_ID=facility-1
REPORTING_INTERVAL_SECONDS=5
INPUT_TYPE=webcam
INPUT_SOURCE=0
FACILITY_CAPACITY=100

# Set the deployed API stage base URL for smoke/integration tooling.
API_BASE_URL=https://your-api-gateway-endpoint.example.com/prod

# Configure AWS IoT TLS paths at runtime. Do not commit certificates or keys.
AWS_IOT_ENDPOINT=your-endpoint.iot.region.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CLIENT_ID=your-client-id
AWS_IOT_TOPIC=cloudcrowd/telemetry
AWS_IOT_CA_PATH=path/to/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=path/to/device-certificate.pem.crt
AWS_IOT_PRIVATE_KEY_PATH=path/to/device-private.pem.key
